{
    "auto_install_extensions": {
        "snazzy": true,
        "material-icon-theme": true,
        "git-firefly": true,
        "toml": true,
        "html": true,
        "make": true,
        "powershell": true,
        "groovy": true
    },
    "theme": "Snazzy Theme - blurred",
    "icon_theme": "Material Icon Theme",
    "buffer_font_family": "MonaspiceNe Nerd Font Mono",
    "buffer_font_size": 14,
    "ui_font_size": 14,

    "vim_mode": true,
    "relative_line_numbers": "enabled",
    "which_key": {
        "enabled": true,
        "delay_ms": 0
    },

    "cli_default_open_behavior": "existing_window",
    "project_panel": { "dock": "left" },
    "outline_panel": { "dock": "left" },
    "collaboration_panel": { "dock": "left" },
    "git_panel": { "dock": "left" },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": []
    },

    "session": {
        "trust_all_worktrees": true
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
            "default_config_options": {
                "effort": "medium",
                "model": "opus[1m]",
                "mode": "bypassPermissions"
            }
        }
    },

    "format_on_save": "on",
    "tab_size": 4,
    "hard_tabs": false,
    "autosave": "off",
    "file_types": {
        "Shell Script": ["conf"]
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    }
}
